{
  "name": "vijana-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm run build:client && npm run build:server && node server/server.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/server.js",
    "build:server": "tsc --target ES2020 --module commonjs --esModuleInterop --strict --skipLibCheck server/server.ts server/db.ts",
    "build:client": "tsc --target ES2017 --lib DOM,ES2017 --strict --skipLibCheck --removeComments public/auth.ts public/payments.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}